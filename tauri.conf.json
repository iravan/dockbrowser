{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DockBrowser",
  "identifier": "dev.dockbrowser.app",
  "build": { "frontendDist": "ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "DockBrowser", "width": 1200, "height": 800 }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'" }
  },
  "bundle": { "icon": ["icons/icon.png"] }
}
